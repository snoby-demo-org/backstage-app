{
  "name": "@backstage/plugin-catalog-import",
  "version": "0.13.17",
  "description": "A Backstage plugin the helps you import entities into your catalog (VENDORED + locally owned)",
  "private": true,
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "catalog-import",
    "pluginPackages": [
      "@backstage/plugin-catalog-import"
    ]
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/catalog-client": "^1.16.1",
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/config": "^1.3.8",
    "@backstage/core-components": "^0.18.13",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/errors": "^1.3.1",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@backstage/integration": "^2.1.1",
    "@backstage/integration-react": "^1.2.21",
    "@backstage/plugin-catalog-common": "^1.1.10",
    "@backstage/plugin-catalog-react": "^3.2.2",
    "@backstage/plugin-permission-react": "^0.5.4",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "4.0.0-alpha.61",
    "@octokit/rest": "^19.0.3",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "git-url-parse": "^15.0.0",
    "js-base64": "^3.6.0",
    "lodash": "^4.17.21",
    "react-hook-form": "^7.12.2",
    "react-use": "^17.2.4",
    "yaml": "^2.0.0"
  },
  "peerDependencies": {
    "@types/react": "^17.0.0 || ^18.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "configSchema": "config.d.ts"
}
